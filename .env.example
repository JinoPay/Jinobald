# 서울 열린데이터광장 "지하철 실시간 도착정보" 인증키
#   발급: https://data.seoul.go.kr  (무료, 일일 호출 한도 있음)
#   미설정 시 앱은 자동으로 모의(mock) 데이터로 동작합니다.
#
# 주의: EXPO_PUBLIC_ 접두사 변수는 JS 번들에 그대로 포함되어 배포된 앱에서
#      추출 가능합니다. 공개 데이터용 저민감 키에만 사용하세요.
EXPO_PUBLIC_SEOUL_SUBWAY_API_KEY=

# API 베이스 URL. 기본값은 http://swopenapi.seoul.go.kr 입니다.
# 해당 호스트가 HTTPS 를 지원하는 것을 확인했다면 https:// 로 바꾸는 편이 좋습니다
# (그 경우 Android cleartext / iOS ATS 예외 설정이 불필요해집니다).
SUBWAY_API_BASE_URL=

# C# 백엔드 주소 (backend/ 참고). 지정하면 앱은 서울 API 대신 이 서버를 통해 실시간·정적 데이터를 받습니다.
#   개발: 같은 Wi-Fi 의 Mac IP, 예) http://192.168.0.10:5080  (시뮬레이터는 http://localhost:5080)
#   운영: https:// 주소 — 그러면 ATS/cleartext 예외가 전혀 필요 없습니다.
# 비워 두면 서울 키(있으면) → 모의 데이터 순으로 동작합니다.
EXPO_PUBLIC_BACKEND_URL=
