{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Urls": "http://0.0.0.0:5080",
  "Database": {
    "Path": "data/subway.db"
  },
  "Datasets": {
    "RawDir": "../../../scripts/data/raw",
    "ImportOnStartup": true
  },
  "Seoul": {
    "ApiKey": "",
    "BaseUrl": "http://swopenapi.seoul.go.kr",
    "TimeoutSeconds": 8,
    "DailyQuota": 1000,
    "SoftLimit": 900
  },
  "DataGoKr": {
    "ServiceKey": "",
    "BaseUrl": "https://apis.data.go.kr",
    "TimeoutSeconds": 8
  },
  "Realtime": {
    "ArrivalsTtlSeconds": 20,
    "PositionsTtlSeconds": 30,
    "SimulatedArrivalWindowSeconds": 1800
  },
  "Timetable": {
    "Holidays": []
  }
