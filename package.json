{
  "name": "jinobald",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.18",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --configuration Release",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:release": "expo run:android --variant release",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "check:native": "node scripts/check-native-setup.mjs",
    "doctor": "pnpm dlx expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/test/register.mjs --test \"src/**/*.test.ts\"",
    "generate-alarm-sound": "node scripts/generate-alarm-sound.mjs",
    "verify-data": "node scripts/verify-data.mjs",
    "verify-routes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs scripts/verify-routes.mjs",
    "build-lines": "node scripts/build-lines.mjs",
    "fetch-datasets": "node scripts/fetch-datasets.mjs",
    "build-transfer-data": "node scripts/build-transfer-data.mjs",
    "verify-transfer-data": "node scripts/verify-transfer-data.mjs",
    "check:backend": "node scripts/check-backend-setup.mjs",
    "backend:build": "dotnet build backend/Jinobald.Subway.slnx",
    "backend:test": "dotnet test backend/Jinobald.Subway.slnx",
    "backend:run": "dotnet run --project backend/src/Jinobald.Subway.Api",
    "backend:import": "dotnet run --project backend/src/Jinobald.Subway.Ingest -- import --raw scripts/data/raw",
    "backend:export": "dotnet run --project backend/src/Jinobald.Subway.Ingest -- export-app-json --out src/data/generated",
    "lint": "expo lint",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:ios:sim": "eas build --profile development-simulator --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all"
  },
  "engines": {
    "node": ">=22.18"
  },
  "private": true
}
